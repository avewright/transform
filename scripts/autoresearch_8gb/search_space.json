{
  "baseline_id": "baseline_deep_small",
  "elo_noise": 100,
  "speed_promote_frac": 0.2,
  "default_train_minutes": 90,
  "default_max_steps": 8000,
  "soft_cache_candidates": [
    "outputs/autoresearch_8gb/soft_cache_200k.pt",
    "outputs/exp186_sf_multipv/soft_cache_merged.pt",
    "outputs/exp186_sf_multipv/soft_cache.pt",
    "outputs/autoresearch_8gb/soft_cache.pt"
  ],
  "deep_cache_candidates": [
    "outputs/autoresearch_8gb/puzzle_syzygy_mix.pt",
    "outputs/syzygy_hf/soft_cache.pt",
    "outputs/exp193_puzzle_soft/soft_cache.pt",
    "outputs/exp190_phase_deep/soft_cache.pt",
    "outputs/lichess_evals_soft/quality_deep_mix.pt",
    "outputs/lichess_evals_soft/soft_cache.pt"
  ],
  "syzygy_hf_repo": "avewright/chess-soft-syzygy",
  "trials": [
    {
      "id": "baseline_deep_small",
      "desc": "28L/256d strengthened + rel_bias + SwiGLU + NorMuon",
      "model": {
        "encoder_dim": 256,
        "encoder_type": "strengthened",
        "encoder_conv_blocks": 2,
        "normalize_stm": true,
        "hidden_dim": 256,
        "num_layers": 28,
        "num_heads": 8,
        "ffn_ratio": 4,
        "dropout": 0.05,
        "policy_head_dim": 192,
        "value_hidden": 128,
        "use_pos_embed": false,
        "n_ctx_tokens": 4,
        "value_head_type": "cls",
        "n_value_classes": 3,
        "use_swiglu": true,
        "use_rel_bias": true,
        "gradient_checkpointing": false,
        "full_dim_attention": false,
        "use_meta_attention": false,
        "use_shaw_on_pos": true
      },
      "train": {
        "batch_size": 96,
        "accum_steps": 2,
        "soft_frac": 1.0,
        "soft_alpha": 0.45,
        "deep_mix_frac": 0.35,
        "hflip_p": 0.5,
        "value_weight": 0.1,
        "optimizer": "normuon",
        "muon_lr": 0.02,
        "adam_lr": 0.0003,
        "weight_decay": 0.01,
        "grad_clip": 1.0,
        "warmup": 200,
        "min_lr_frac": 0.05,
        "min_depth": 12,
        "torch_compile": false,
        "grad_checkpoint": false
      }
    },
    {
      "id": "meta_shaw_no_relbias",
      "desc": "Same size + meta attention + Shaw, no handcrafted rel_bias",
      "model": {
        "encoder_dim": 256,
        "encoder_type": "strengthened",
        "encoder_conv_blocks": 2,
        "normalize_stm": true,
        "hidden_dim": 256,
        "num_layers": 24,
        "num_heads": 8,
        "ffn_ratio": 4,
        "dropout": 0.05,
        "policy_head_dim": 192,
        "value_hidden": 128,
        "use_pos_embed": false,
        "n_ctx_tokens": 4,
        "value_head_type": "cls",
        "n_value_classes": 3,
        "use_swiglu": true,
        "use_rel_bias": false,
        "gradient_checkpointing": false,
        "full_dim_attention": false,
        "use_meta_attention": true,
        "use_shaw_on_pos": true
      },
      "train": {
        "batch_size": 64,
        "accum_steps": 3,
        "soft_frac": 1.0,
        "soft_alpha": 0.45,
        "deep_mix_frac": 0.35,
        "hflip_p": 0.5,
        "value_weight": 0.1,
        "optimizer": "normuon",
        "muon_lr": 0.02,
        "adam_lr": 0.0003,
        "weight_decay": 0.01,
        "grad_clip": 1.0,
        "warmup": 200,
        "min_lr_frac": 0.05,
        "min_depth": 12,
        "torch_compile": false,
        "grad_checkpoint": true
      }
    },
    {
      "id": "wider_shallower",
